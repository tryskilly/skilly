{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skilly",
  "version": "0.1.0",
  "identifier": "app.tryskilly.skilly",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Skilly",
        "width": 336,
        "height": 540,
        "minWidth": 336,
        "minHeight": 480,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["skilly"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Triskay Ltd",
    "resources": {
      "../../skills/": "skills/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Arabic"]
      }
    }
  }
}
